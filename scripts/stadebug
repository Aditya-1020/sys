set -euo pipefail

# shellcheck source=lib/librelane_env.sh
source "$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/lib/librelane_env.sh"

RUN="" CORNER="" GUI=0 LIST=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--corner) CORNER="$2"; shift 2 ;;
        --gui) GUI=1; shift ;;
        -l|--list-corners) LIST=1; shift ;;
        -h|--help) sed -n '2,22p' "$0" | sed 's/^# \?//'; exit 0 ;;
        -*) echo "error: unknown flag $1 (see --help)" >&2; exit 1 ;;
        *) RUN="$1"; shift ;;
    esac
done

# --- resolve run / STA step / corner -----------------------------------------
RUN_DIR=$(ll_resolve_run "$RUN")
STA_DIR=$(ll_sta_dir "$RUN_DIR" openroad-stapostpnr)

if [[ $LIST -eq 1 ]]; then
    ll_list_corners "$STA_DIR"; exit 0
fi

[[ -n "$CORNER" ]] || CORNER=$(ll_default_corner "$STA_DIR")

# reconstructs the step's per-corner environment from its own sta.log
ll_export_env "$STA_DIR" "$CORNER"
SDC="$LL_SDC"
SPEF="$LL_SPEF"

LOADER="$(cd "$(dirname "$0")" && pwd)/stadebug.tcl"

echo "── stadebug ──────────────────────────────────────────────"
echo "run:    $RUN_DIR"
echo "corner: $CORNER"
echo "sdc:    $SDC"
echo "spef:   ${SPEF:-none (unannotated!)}"
echo "──────────────────────────────────────────────────────────"

if [[ $GUI -eq 1 ]]; then
    exec openroad -no_splash -gui "$LOADER"
elif command -v rlwrap >/dev/null 2>&1 && [[ -t 0 ]]; then
    exec rlwrap sta -no_splash "$LOADER"   # rlwrap: arrow-key history/editing
else
    exec sta -no_splash "$LOADER"
fi
