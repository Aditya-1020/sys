                   "-0.032, -0.032, -0.032");
            }
        }
    }

    pin(clk0){
        clock             : true;
        direction  : input; 
        capacitance : 0.006889999999999999;  
        internal_power(){
            when : "!csb0 & !web0"; 
            rise_power(scalar){
                values("3.187988e+00");
            }
            fall_power(scalar){
                values("3.724230e+00");
            }
        }
        internal_power(){
            when : "csb0 & !web0"; 
            rise_power(scalar){
                values("2.372174e+00");
            }
            fall_power(scalar){
                values("1.509366e+00");
            }
        }
        internal_power(){
            when : "!csb0 & web0"; 
            rise_power(scalar){
                values("2.916197e+00");
            }
            fall_power(scalar){
                values("2.703813e+00");
            }
        }
        internal_power(){
            when : "csb0 & web0"; 
            rise_power(scalar){
                values("1.516071e+00");
            }
            fall_power(scalar){
                values("1.582950e+00");
            }
        }
        timing(){ 
            timing_type : "min_pulse_width"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("2.5025"); 
            }
            fall_constraint(scalar) {
                values("2.5025"); 
            }
         }
        timing(){ 
            timing_type : "minimum_period"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("5.005"); 
            }
            fall_constraint(scalar) {
                values("5.005"); 
            }
         }
    }

