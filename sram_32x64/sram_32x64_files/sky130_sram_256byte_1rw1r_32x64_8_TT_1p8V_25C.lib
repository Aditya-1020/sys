        pin(dout1[31:0]){
        timing(){ 
            timing_sense : non_unate; 
            related_pin : "clk1"; 
            timing_type : falling_edge; 
            cell_rise(CELL_TABLE) {
            values("1.584, 1.887, 2.428",\
                   "1.584, 1.888, 2.429",\
                   "1.592, 1.895, 2.437");
            }
            cell_fall(CELL_TABLE) {
